---
const { pathname } = Astro.url;
const isProjectPage = pathname.startsWith('/projects/');
---

<header
  id="floating-nav"
  class="sticky top-0 z-[100] w-full border-b border-white/5 bg-[#111114]/80 px-5 py-[13px] backdrop-blur-md transition-all duration-400 ease-[cubic-bezier(0.16,1,0.3,1)] md:px-10"
  style="will-change: transform;"
>
  <div class="flex items-center justify-between w-full gap-4 md:gap-0">

    <!-- Logo / Back link -->
    {isProjectPage ? (
      <a
        href="/"
        class="flex-shrink-0 font-display text-[0.9rem] font-bold tracking-wider text-text-muted transition-colors hover:text-accent"
        data-i18n="nav.back"
        aria-label="Back to homepage"
      >
        ← Back
      </a>
    ) : (
      <a
        href="#"
        id="nav-logo-link"
        class="group relative flex-shrink-0 w-9 h-9 md:w-10 md:h-10"
        aria-label="Omar Zaghloul — scroll to top"
        onclick="window.scrollTo({ top: 0, behavior: 'smooth' }); return false;"
      >
        <!-- White logo (default) -->
        <img
          src="/logo/OZ-logo-white.png"
          alt="OZ logo"
          width="40"
          height="40"
          class="absolute inset-0 w-full h-full object-contain transition-opacity duration-300 opacity-100 group-hover:opacity-0 group-focus:opacity-0"
          id="logo-white"
        />
        <!-- Accent logo (hover/focus) -->
        <img
          src="/logo/OZ-logo-accent.png"
          alt=""
          width="40"
          height="40"
          class="absolute inset-0 w-full h-full object-contain transition-opacity duration-300 opacity-0 group-hover:opacity-100 group-focus:opacity-100"
          id="logo-accent"
          aria-hidden="true"
        />
      </a>
    )}

    <!-- Nav links + Language toggle -->
    <div class="flex items-center justify-end flex-1 min-w-0">
      <nav
        class="flex items-center gap-4 md:gap-9"
      >

        {isProjectPage ? (
          <>
            <a href="/#work"     class="nav-link relative text-[0.82rem] md:text-[0.95rem] font-medium text-text-muted transition-colors hover:text-accent" data-i18n="nav.work">Work</a>
            <a href="/#services" class="nav-link relative text-[0.82rem] md:text-[0.95rem] font-medium text-text-muted transition-colors hover:text-accent" data-i18n="nav.services">Services</a>
            <a href="/#about"    class="nav-link relative text-[0.82rem] md:text-[0.95rem] font-medium text-text-muted transition-colors hover:text-accent" data-i18n="nav.about">About</a>
            <a href="/#faq"      class="nav-link relative text-[0.82rem] md:text-[0.95rem] font-medium text-text-muted transition-colors hover:text-accent" data-i18n="nav.faq">FAQ</a>
            <a href="/#contact"  class="nav-link relative text-[0.82rem] md:text-[0.95rem] font-medium text-text-muted transition-colors hover:text-accent" data-i18n="nav.contact">Contact</a>
          </>
        ) : (
          <>
            <a href="#work"     class="nav-link relative text-[0.82rem] md:text-[0.95rem] font-medium text-text-muted transition-colors hover:text-accent" data-i18n="nav.work">Work</a>
            <a href="#services" class="nav-link relative text-[0.82rem] md:text-[0.95rem] font-medium text-text-muted transition-colors hover:text-accent" data-i18n="nav.services">Services</a>
            <a href="#about"    class="nav-link relative text-[0.82rem] md:text-[0.95rem] font-medium text-text-muted transition-colors hover:text-accent" data-i18n="nav.about">About</a>
            <a href="#faq"      class="nav-link relative text-[0.82rem] md:text-[0.95rem] font-medium text-text-muted transition-colors hover:text-accent" data-i18n="nav.faq">FAQ</a>
            <a href="#contact"  class="nav-link relative text-[0.82rem] md:text-[0.95rem] font-medium text-text-muted transition-colors hover:text-accent" data-i18n="nav.contact">Contact</a>
          </>
        )}
      </nav>

      <!-- Language Toggle -->
      <div
        id="language-toggle"
        class="flex items-center flex-shrink-0 gap-[4px] md:gap-[6px] font-body text-[0.78rem] md:text-[0.88rem] font-medium ml-3 md:ml-4 pl-3 md:pl-4 border-l border-border/50"
      >
        <button class="lang-btn text-accent transition-colors hover:text-accent" data-lang="en" aria-label="Switch to English">EN</button>
        <span class="text-text-muted/40 text-[9px]">|</span>
        <button class="lang-btn text-text-muted transition-colors hover:text-accent" data-lang="ar" aria-label="Switch to Arabic">AR</button>
        <span class="text-text-muted/40 text-[9px]">|</span>
        <button class="lang-btn text-text-muted transition-colors hover:text-accent" data-lang="tr" aria-label="Switch to Turkish">TR</button>
      </div>
    </div>
  </div>
</header>

<style>
  .backdrop-blur-md {
    backdrop-filter: blur(16px) saturate(120%);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
  }

  /* Nav link active underline */
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-accent, #A8DD07);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  [dir="rtl"] .nav-link::after {
    left: auto;
    right: 0;
    transform-origin: right;
  }
  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }
  .nav-link.active {
    color: var(--color-accent, #A8DD07);
  }

  /* Language transition */
  :global(.lang-transition) {
    transition: opacity 0.2s ease-in-out !important;
  }
  :global(.lang-swapping) {
    opacity: 0 !important;
  }
</style>

<script>
  import { gsap } from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  import { translations } from "../utils/translations";

  gsap.registerPlugin(ScrollTrigger);

  const initNav = () => {
    const nav = document.getElementById('floating-nav');
    const navLinks = document.querySelectorAll('.nav-link');

    if (!nav) return;

    gsap.set(nav, { y: 0 });

    // Active section highlighting
    const sections = document.querySelectorAll('section[id], footer[id]');

    const updateActiveLink = () => {
      const scrollPosition = window.scrollY + window.innerHeight / 3;
      let currentSectionId = "";

      sections.forEach(section => {
        const top = (section as HTMLElement).offsetTop;
        const height = (section as HTMLElement).offsetHeight;
        if (scrollPosition >= top && scrollPosition < top + height) {
          const id = section.getAttribute('id');
          if (id === 'footer-section' || id === 'contact') {
            currentSectionId = 'contact';
          } else {
            currentSectionId = id || "";
          }
        }
      });

      navLinks.forEach(link => {
        link.classList.remove('active');
        const href = link.getAttribute('href');
        if (href && (href === `#${currentSectionId}` || href === `/#${currentSectionId}`)) {
          link.classList.add('active');
        }
      });
    };

    window.addEventListener('scroll', updateActiveLink);
    updateActiveLink();

    // RTL/lang update
    const applyLangToDoc = (lang: string) => {
      const html = document.documentElement;
      html.setAttribute('lang', lang);
      html.setAttribute('dir', lang === 'ar' ? 'rtl' : 'ltr');
    };

    // Translation application
    const applyTranslation = (lang: string, withAnimation = true) => {
      const t = translations[lang] || translations['en'];
      const elements = document.querySelectorAll('[data-i18n], [data-i18n-array]');

      const updateDom = () => {
        document.querySelectorAll("[data-i18n]").forEach(el => {
          const key = el.getAttribute("data-i18n");
          if (key && t[key]) {
            el.innerHTML = t[key];
          }
        });
        document.querySelectorAll("[data-i18n-array]").forEach(el => {
          const key = el.getAttribute("data-i18n-array");
          if (key && t[key]) {
            const contents = t[key].split('\n\n').filter(Boolean);
            el.innerHTML = contents.map((p: string) => `<p>${p}</p>`).join('');
          }
        });
        applyLangToDoc(lang);
      };

      if (withAnimation) {
        elements.forEach(el => el.classList.add('lang-transition'));
        elements.forEach(el => el.classList.add('lang-swapping'));

        setTimeout(() => {
          updateDom();
          elements.forEach(el => el.classList.remove('lang-swapping'));
          setTimeout(() => {
            elements.forEach(el => el.classList.remove('lang-transition'));
            ScrollTrigger.refresh();
          }, 200);
        }, 200);
      } else {
        updateDom();
      }

      // Update toggle button styling
      document.querySelectorAll(".lang-btn").forEach(btn => {
        if (btn.getAttribute("data-lang") === lang) {
          btn.classList.add("text-accent");
          btn.classList.remove("text-text-muted");
        } else {
          btn.classList.add("text-text-muted");
          btn.classList.remove("text-accent");
        }
      });
    };

    // Init from localStorage
    const savedLang = localStorage.getItem('i18n_lang') || 'en';
    applyTranslation(savedLang, false);

    // Toggle click events
    document.querySelectorAll(".lang-btn").forEach(btn => {
      btn.addEventListener('click', (e) => {
        const targetLang = (e.currentTarget as HTMLElement).getAttribute('data-lang');
        const currentLang = localStorage.getItem('i18n_lang') || 'en';
        if (targetLang && targetLang !== currentLang) {
          localStorage.setItem('i18n_lang', targetLang);
          applyTranslation(targetLang);
        }
      });
    });
  };

  document.addEventListener("astro:page-load", initNav);
</script>
