---
---
<footer class="border-t border-border/30 bg-bg px-6 py-28 lg:px-16" id="contact">
  <div class="mx-auto flex w-full max-w-7xl flex-col items-center justify-center text-center">

    <div class="relative mb-8 flex flex-col items-center">
      <h2
        id="footer-header"
        class="relative font-display text-[clamp(2.5rem,5vw,4rem)] font-bold tracking-tight text-text opacity-0"
        data-i18n="contact.header"
      >
        Let's talk
      </h2>
    </div>

    <!-- Primary CTA -->
    <a
      id="footer-cta"
      href="https://cal.com/omar-ztech/discovery"
      target="_blank"
      rel="noopener noreferrer"
      class="mb-16 inline-flex items-center gap-2 rounded-full bg-accent px-8 py-4 font-body text-base font-medium text-bg opacity-0 transition-all duration-300 hover:brightness-110 hover:shadow-[0_0_30px_rgba(168,221,7,0.3)]"
      data-i18n="contact.cta"
    >
      Book a free discovery call
    </a>

    <!-- Social links -->
    <div id="footer-links" class="mb-12 flex flex-wrap justify-center gap-8 opacity-0">
      <a
        href="https://www.linkedin.com/in/omar-zaghloul-061021241/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover-link font-body text-base text-text-muted hover:text-text transition-colors"
      >
        LinkedIn
      </a>
      <a
        href="https://www.instagram.com/omar.ztech/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover-link font-body text-base text-text-muted hover:text-text transition-colors"
      >
        Instagram
      </a>
      <a
        href="mailto:omarhesham87878@gmail.com"
        class="hover-link font-body text-base text-text-muted hover:text-text transition-colors"
      >
        omarhesham87878@gmail.com
      </a>
    </div>

    <p class="font-body text-sm text-text-muted/50" data-i18n="footer.copy">
      © 2026 Omar Zaghloul
    </p>
  </div>
</footer>

<script>
  import { gsap } from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initFooterAnimation = () => {
    gsap.killTweensOf("#footer-header, #footer-cta, #footer-links");

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#contact",
        start: "top 85%",
      }
    });

    tl.fromTo(
      "#footer-header",
      { y: 30, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.8, ease: "power3.out" }
    )
    .fromTo(
      "#footer-cta",
      { y: 20, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.6, ease: "power3.out" },
      "-=0.4"
    )
    .fromTo(
      "#footer-links",
      { y: 20, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.6, ease: "power3.out" },
      "-=0.4"
    );
  };

  document.addEventListener("astro:page-load", initFooterAnimation);
</script>
