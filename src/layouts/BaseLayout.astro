---
import { ViewTransitions, fade } from 'astro:transitions';
import '../styles/global.css';
import FloatingNav from '../components/FloatingNav.astro';

interface Props {
  title?: string;
  description: string;
  ogImage?: string;
  canonicalPath?: string;
}

const {
  title = 'Omar Zaghloul | Technical Product Engineer',
  description,
  ogImage = '/avatar/oz-hero.png',
  canonicalPath,
} = Astro.props;

const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, 'https://www.omarzaghloul.com').href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Omar Zaghloul",
  "url": Astro.site ? Astro.site.toString() : Astro.url.origin,
  "jobTitle": "Technical Product Engineer",
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "Kadir Has University"
  },
  "sameAs": [
    "https://www.linkedin.com/in/omar-zaghloul-061021241/",
    "https://www.instagram.com/omar.ztech/"
  ]
};
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/OZ_logo.png" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700&family=DM+Mono:wght@400;500&family=IBM+Plex+Arabic:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <ViewTransitions />
  </head>
  <body class="overflow-x-hidden antialiased" transition:animate={fade({ duration: '0.4s' })}>
    <!-- Custom Cursor -->
    <div id="custom-cursor" class="custom-cursor hidden md:block"></div>

    <!-- Cursor Glow Spotlight -->
    <div id="cursor-glow"></div>

    <FloatingNav />

    <slot />

    <!-- RTL / lang hydration — runs before paint to avoid flash -->
    <script is:inline>
      (function () {
        var lang = localStorage.getItem('i18n_lang') || 'en';
        var html = document.documentElement;
        html.setAttribute('lang', lang);
        html.setAttribute('dir', lang === 'ar' ? 'rtl' : 'ltr');
      })();
    </script>

    <script>
      import { gsap } from "gsap";

      const initCursor = () => {
        if (window.matchMedia("(pointer: coarse)").matches) return;

        const cursor = document.getElementById("custom-cursor");
        if (!cursor) return;

        gsap.set(cursor, { autoAlpha: 1 });

        let xTo = gsap.quickTo(cursor, "x", { duration: 0.2, ease: "power3", force3D: true });
        let yTo = gsap.quickTo(cursor, "y", { duration: 0.2, ease: "power3", force3D: true });

        const onMouseMove = (e: MouseEvent) => {
          xTo(e.clientX - 6);
          yTo(e.clientY - 6);
        };

        window.addEventListener("mousemove", onMouseMove);

        const initHoverBehaviors = () => {
          const interactiveElements = document.querySelectorAll("a, button, .project-card, input, select, textarea");
          interactiveElements.forEach((el) => {
            el.addEventListener("mouseenter", () => cursor.classList.add("hovering"));
            el.addEventListener("mouseleave", () => cursor.classList.remove("hovering"));
          });
        };

        initHoverBehaviors();
      };

      document.addEventListener("astro:page-load", initCursor);
    </script>

    <script>
      let _glowRafId: number | null = null;

      const initCursorGlow = () => {
        if (window.matchMedia('(pointer: coarse)').matches) return;

        const glow = document.getElementById('cursor-glow');
        if (!glow) return;

        if (_glowRafId !== null) {
          cancelAnimationFrame(_glowRafId);
          _glowRafId = null;
        }

        glow.style.display = 'block';

        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 2;
        let glowX = mouseX;
        let glowY = mouseY;

        const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

        const tick = () => {
          glowX = lerp(glowX, mouseX, 0.15);
          glowY = lerp(glowY, mouseY, 0.15);
          glow.style.left = glowX + 'px';
          glow.style.top = glowY + 'px';
          _glowRafId = requestAnimationFrame(tick);
        };

        window.addEventListener('mousemove', (e: MouseEvent) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          glow.style.opacity = '1';
        });

        document.addEventListener('mouseleave', () => {
          glow.style.opacity = '0';
        });

        document.querySelectorAll('a, button, [role="link"], .project-card').forEach(el => {
          el.addEventListener('mouseenter', () => glow.classList.add('hovering'));
          el.addEventListener('mouseleave', () => glow.classList.remove('hovering'));
        });

        tick();
      };

      document.addEventListener('astro:page-load', initCursorGlow);
    </script>
  </body>
</html>
