---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);

// Map projects to their outcome captions and categories
const projectMeta: Record<string, { category: string; caption: string }> = {
  oncoflow:       { category: 'Healthcare / SaaS',       caption: 'Replaced paper tracking with one dashboard for oncology treatment cycles.' },
  altinkapi:      { category: 'Travel / E-Commerce',     caption: 'Bilingual Hajj and Umrah booking platform with live availability.' },
  educounsellor:  { category: 'EdTech / SaaS',           caption: 'White label dashboard replacing WhatsApp chaos for application agencies.' },
  spotter:        { category: 'Health & Fitness / Mobile',caption: 'One app replacing four for tracking, coaching and nutrition.' },
  'reverse-swing':{ category: 'Sports / Content',        caption: 'Long form cricket writing with a purpose built CMS behind it.' },
};
---

<BaseLayout
  title="Omar Zaghloul — Technical Product Engineer"
  description="Custom systems, platforms and automations built to turn operational friction into leverage."
  ogImage="/avatar/oz-hero.png"
>

  <!-- ═══════════════════════════ HERO ═══════════════════════════ -->
  <section class="relative flex min-h-[100dvh] w-full items-center justify-center overflow-hidden bg-bg px-6 lg:px-16 border-b border-border/50">
    <!-- Noise overlay -->
    <div class="pointer-events-none absolute inset-0 z-0 h-full w-full opacity-[0.025]">
      <svg class="h-full w-full">
        <filter id="noise">
          <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="4" stitchTiles="stitch" />
        </filter>
        <rect width="100%" height="100%" filter="url(#noise)" />
      </svg>
    </div>

    <!-- Main hero container -->
    <div class="relative z-10 flex w-full max-w-7xl flex-col-reverse items-center justify-between pt-24 pb-12 lg:flex-row lg:py-0">

      <!-- Text content (left) -->
      <div class="relative z-20 mt-10 flex flex-col items-center text-center lg:mt-0 lg:w-1/2 lg:items-start lg:text-left">
        <p
          id="hero-eyebrow"
          class="mb-4 font-body text-sm font-medium tracking-[0.2em] uppercase text-accent opacity-0"
          data-i18n="hero.eyebrow"
        >
          Technical Product Engineer
        </p>

        <h1
          id="hero-name"
          class="font-display text-[clamp(2.25rem,5vw,3.625rem)] font-bold leading-none tracking-tight text-text opacity-0"
          data-i18n="hero.name"
        >
          Omar Zaghloul
        </h1>

        <p
          id="hero-subhead"
          class="mt-6 max-w-md font-body text-[1.0625rem] leading-[1.7] text-text-muted opacity-0"
          data-i18n="hero.subhead"
        >
          Custom systems, platforms and automations built to turn operational friction into leverage.
        </p>

        <!-- CTAs -->
        <div id="hero-ctas" class="mt-10 flex flex-wrap items-center gap-4 opacity-0">
          <a
            href="https://cal.com/omar-ztech/discovery"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 font-body text-sm font-medium text-bg transition-all duration-300 hover:brightness-110 hover:shadow-[0_0_20px_rgba(168,221,7,0.35)]"
            data-i18n="hero.cta.primary"
          >
            Book a free discovery call
          </a>
          <a
            href="#work"
            class="inline-flex items-center gap-2 font-body text-sm font-medium text-text-muted transition-colors hover:text-text"
            data-i18n="hero.cta.secondary"
          >
            See the work <span class="dir-arrow">→</span>
          </a>
        </div>
      </div>

      <!-- Avatar (right / top on mobile) -->
      <div class="relative z-10 flex items-center justify-center lg:w-1/2">
        <!-- Radial glow -->


        <div id="hero-avatar" class="relative opacity-0 not-rtl-mirror">
          <img
            src="/avatar/oz-hero.png"
            alt="Omar Zaghloul"
            class="relative z-10 h-auto w-full max-w-[320px] object-contain drop-shadow-2xl md:max-w-[480px] lg:max-w-[560px]"
            width="560"
            height="560"
            onerror="this.style.display='none'; this.parentElement.style.minHeight='400px';"
          />
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center justify-center opacity-50">
      <div class="h-12 w-[2px] overflow-hidden rounded-full bg-border">
        <div class="animate-scroll-down h-1/2 w-full bg-accent"></div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ WORK ═══════════════════════════ -->
  <section class="relative w-full bg-bg px-6 py-24 lg:px-16" id="work">
    <!-- Section header -->
    <div class="mx-auto w-full max-w-7xl mb-16">
      <p class="work-fade mb-3 font-body text-xs font-medium tracking-[0.2em] uppercase text-accent opacity-0" data-i18n="work.eyebrow">In production</p>
      <h2 class="work-fade font-display text-[clamp(1.75rem,3.5vw,2.25rem)] font-bold tracking-tight text-text opacity-0" data-i18n="work.header">
        Selected work
      </h2>
    </div>

    <!-- Project flip-card grid -->
    <div class="mx-auto w-full max-w-7xl grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedProjects.map((project, i) => {
        const meta = projectMeta[project.slug] || { category: project.data.category, caption: project.data.subtitle };
        return (
          <div
            class="flip-card work-card aspect-[4/3] w-full opacity-0 rounded-xl overflow-hidden"
            style={`--delay: ${i * 0.08}s`}
          >
            <div class="flip-card-inner border border-border">
              <!-- Front face -->
              <div class="flip-card-front relative w-full h-full rounded-xl overflow-hidden bg-surface">
                <Image
                  src={project.data.thumbnail}
                  alt={project.data.title}
                  format="webp"
                  quality={80}
                  class="absolute inset-0 h-full w-full object-cover"
                />
                <!-- Always-visible overlay bar at bottom -->
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-bg via-bg/80 to-transparent px-5 pt-12 pb-5">
                  <p class="text-xs font-medium tracking-[0.15em] uppercase text-accent mb-1" data-i18n={`projects.${project.slug}.category`}>
                    {meta.category}
                  </p>
                  <h3 class="font-display text-xl font-bold text-text">{project.data.title}</h3>
                </div>
              </div>

              <!-- Back face -->
              <div class="flip-card-back flex flex-col justify-center bg-surface px-7 py-8">
                <p class="text-xs font-medium tracking-[0.15em] uppercase text-accent mb-3" data-i18n={`projects.${project.slug}.category`}>
                  {meta.category}
                </p>
                <h3 class="font-display text-2xl font-bold text-text mb-4">{project.data.title}</h3>
                <p class="font-body text-sm leading-[1.7] text-text-muted" data-i18n={`projects.${project.slug}.caption`}>
                  {meta.caption}
                </p>
                <a
                  href={`/projects/${project.slug}/`}
                  class="mt-6 inline-flex items-center gap-2 font-body text-sm font-medium text-accent hover:text-text transition-colors"
                  aria-label={`View ${project.data.title} case study`}
                >
                  View case study <span class="dir-arrow">→</span>
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- ═══════════════════════════ SERVICES ═══════════════════════════ -->
  <section class="relative w-full bg-surface/40 px-6 py-24 lg:px-16 border-t border-b border-border/50" id="services">
    <div class="mx-auto w-full max-w-7xl">
      <!-- Header -->
      <div class="mb-16">
        <p class="services-fade mb-3 font-body text-xs font-medium tracking-[0.2em] uppercase text-accent opacity-0" data-i18n="services.eyebrow">Where I help</p>
        <h2 class="services-fade font-display text-[clamp(1.75rem,3.5vw,2.25rem)] font-bold tracking-tight text-text opacity-0" data-i18n="services.header">
          Services
        </h2>
      </div>

      <!-- Cards grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { num: '01', titleKey: 'services.01.title', descKey: 'services.01.desc', titleDefault: 'Custom Web Platforms', descDefault: 'Built around how your team actually works, so people stop working around the software.' },
          { num: '02', titleKey: 'services.02.title', descKey: 'services.02.desc', titleDefault: 'AI & Workflow Automation', descDefault: 'The manual steps between your tools disappear, and stay gone.' },
          { num: '03', titleKey: 'services.03.title', descKey: 'services.03.desc', titleDefault: 'E-Commerce Solutions', descDefault: 'Storefronts, landing pages and portfolio sites launched fast, on a foundation that does not need rebuilding once it works.' },
          { num: '04', titleKey: 'services.04.title', descKey: 'services.04.desc', titleDefault: 'Business Operating Systems', descDefault: 'SaaS, CRM and ERP platforms that put your data in one place instead of five.', subtitleKey: 'services.04.subtitle', subtitleDefault: 'SaaS, CRM & ERP platforms' },
        ].map((service, i) => (
          <div
            class="service-card group rounded-2xl border border-border/60 bg-bg p-8 md:p-10 opacity-0 transition-all duration-300 hover:border-border hover:bg-surface/60"
            style={`--delay: ${i * 0.1}s`}
          >
            <p class="font-display text-[4rem] font-bold leading-none text-accent/20 mb-6 group-hover:text-accent/30 transition-colors duration-300">
              {service.num}
            </p>
            <h3 class="font-display text-xl font-bold text-text mb-2" data-i18n={service.titleKey}>
              {service.titleDefault}
            </h3>
            {service.subtitleKey && (
              <p class="font-body text-xs text-text-muted mb-3 tracking-wide" data-i18n={service.subtitleKey}>
                {service.subtitleDefault}
              </p>
            )}
            <p class="font-body text-[0.9375rem] leading-[1.7] text-text-muted" data-i18n={service.descKey}>
              {service.descDefault}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ ABOUT ═══════════════════════════ -->
  <section class="relative w-full bg-bg px-6 py-32 lg:px-16" id="about">
    <div class="mx-auto w-full max-w-[800px]">
      <h2
        id="about-header"
        class="mb-16 font-display text-[clamp(1.75rem,4vw,3rem)] font-bold leading-tight tracking-tight text-text opacity-0"
        data-i18n="about.header"
      >
        The bottleneck is never demand. It is the system underneath it.
      </h2>

      <div class="flex flex-col gap-8">
        <p
          class="about-para font-body text-[1.125rem] leading-[1.8] text-text/85 opacity-0"
          data-i18n="about.p1"
        >
          Every business I have worked with reached the same moment: growth outpaced the systems holding it together. A schedule kept on paper. Applications tracked across a hundred chat threads. Data nobody fully trusted. None of that needed another tool stacked on top, it needed one system designed around how the business actually runs.
        </p>
        <p
          class="about-para font-body text-[1.125rem] leading-[1.8] text-text/85 opacity-0"
          data-i18n="about.p2"
        >
          A good system is leverage you only have to build once and it keeps paying you back. That is the work: computer engineering and product thinking applied to real operational pain, one person accountable from the first call to the last deploy. No handoffs, no account managers, no one relearning your business from scratch.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ FAQ ═══════════════════════════ -->
  <section class="relative w-full bg-surface/30 px-6 py-24 lg:px-16 border-t border-border/50" id="faq">
    <div class="mx-auto w-full max-w-[720px]">
      <!-- Header -->
      <div class="mb-14">
        <p class="faq-fade mb-3 font-body text-xs font-medium tracking-[0.2em] uppercase text-accent opacity-0" data-i18n="faq.eyebrow">Before you ask</p>
        <h2 class="faq-fade font-display text-[clamp(1.75rem,3.5vw,2.25rem)] font-bold tracking-tight text-text opacity-0" data-i18n="faq.header">
          FAQ
        </h2>
      </div>

      <!-- Accordion -->
      <div class="flex flex-col divide-y divide-border/60" id="faq-accordion">
        {[
          {
            q: 'What services do you offer?',
            a: 'Custom web platforms, AI and workflow automation, e-commerce, and SaaS, CRM and ERP systems, whatever the business actually needs to run better.',
            qKey: 'faq.q1', aKey: 'faq.a1',
          },
          {
            q: 'How long does a typical project take?',
            a: 'Depends on scope, always. A focused platform can ship in weeks, a full operating system takes longer. Timelines get locked in before work starts, never guessed at along the way.',
            qKey: 'faq.q2', aKey: 'faq.a2',
          },
          {
            q: 'How do I get a price estimate?',
            a: 'Every project is scoped on its own terms, never off a template. A free discovery call gets you a clear number, fast.',
            qKey: 'faq.q3', aKey: 'faq.a3',
            hasLink: true,
          },
          {
            q: 'What is your payment process?',
            a: 'Half upfront to begin, half on delivery. Simple, and it keeps both sides accountable to the timeline.',
            qKey: 'faq.q4', aKey: 'faq.a4',
          },
          {
            q: 'Do you offer support after launch?',
            a: 'Two weeks of support are included with every launch, free. After that, ongoing support runs monthly, priced to the project, not a flat rate.',
            qKey: 'faq.q5', aKey: 'faq.a5',
          },
        ].map((item, i) => (
          <div class="faq-item faq-fade opacity-0" data-index={i}>
            <button
              class="faq-trigger w-full flex items-center justify-between gap-6 py-6 text-left"
              aria-expanded={i === 0 ? 'true' : 'false'}
              id={`faq-btn-${i}`}
              aria-controls={`faq-panel-${i}`}
            >
              <span class="font-display text-[1.0625rem] font-bold text-text" data-i18n={item.qKey}>
                {item.q}
              </span>
              <span class="faq-icon flex-shrink-0 w-5 h-5 rounded-full border border-border/60 flex items-center justify-center text-text-muted text-sm">
                +
              </span>
            </button>

            <div
              class="faq-answer"
              id={`faq-panel-${i}`}
              role="region"
              aria-labelledby={`faq-btn-${i}`}
            >
              <div class="pb-6">
                {item.hasLink ? (
                  <p class="font-body text-[0.9375rem] leading-[1.75] text-text-muted">
                    <span data-i18n={item.aKey}>{item.a}</span>{' '}
                    <a
                      href="https://cal.com/omar-ztech/discovery"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-accent hover:underline"
                      data-i18n="faq.a3.linkText"
                    >
                      Book one here.
                    </a>
                  </p>
                ) : (
                  <p class="font-body text-[0.9375rem] leading-[1.75] text-text-muted" data-i18n={item.aKey}>
                    {item.a}
                  </p>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />

  <script>
    import { gsap } from "gsap";
    import ScrollTrigger from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initAnimations = () => {
      // Reduced motion — show everything immediately
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.set(
          '#hero-eyebrow, #hero-name, #hero-subhead, #hero-ctas, #hero-avatar, .work-fade, .work-card, .services-fade, .service-card, #about-header, .about-para, .faq-fade, .faq-item',
          { opacity: 1, y: 0, x: 0 }
        );
        // Open first FAQ
        const firstAnswer = document.querySelector('.faq-answer') as HTMLElement;
        if (firstAnswer) firstAnswer.style.height = 'auto';
        return;
      }

      gsap.killTweensOf('#hero-eyebrow, #hero-name, #hero-subhead, #hero-ctas, #hero-avatar');

      // ── Hero: character-by-character stagger on name ──────────
      const heroName = document.getElementById('hero-name');
      if (heroName) {
        heroName.style.opacity = '1';
        const fullName = 'Omar Zaghloul';
        const chars = Array.from(fullName).map(c =>
          `<span class="hero-char" style="display:inline-block;opacity:0">${c === ' ' ? '&nbsp;' : c}</span>`
        ).join('');
        heroName.innerHTML = chars;

        const charEls = heroName.querySelectorAll('.hero-char');
        const staggerEnd = (charEls.length - 1) * 0.035;

        gsap.fromTo(charEls,
          { opacity: 0, y: 40, rotateX: -40, transformPerspective: 400 },
          { opacity: 1, y: 0, rotateX: 0, duration: 0.6, stagger: 0.035, ease: 'back.out(1.7)' }
        );

        gsap.fromTo('#hero-eyebrow',
          { y: 15, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out', delay: 0.1 }
        );
        gsap.fromTo('#hero-subhead',
          { y: 20, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.6, ease: 'power3.out', delay: staggerEnd + 0.2 }
        );
        gsap.fromTo('#hero-ctas',
          { y: 20, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.6, ease: 'power3.out', delay: staggerEnd + 0.35 }
        );
      }

      // Avatar
      gsap.fromTo('#hero-avatar',
        { scale: 0.96, opacity: 0 },
        { scale: 1, opacity: 1, duration: 1.1, ease: 'power3.out' }
      );

      // ── Work section ──────────────────────────────────────────
      gsap.fromTo('.work-fade',
        { y: 30, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.7, stagger: 0.1, ease: 'power3.out',
          scrollTrigger: { trigger: '#work', start: 'top 80%' } }
      );

      (gsap.utils.toArray('.work-card') as Element[]).forEach((card, i) => {
        gsap.fromTo(card,
          { y: 40, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out', delay: i * 0.08,
            scrollTrigger: { trigger: card, start: 'top 88%' } }
        );
      });

      // ── Services section ──────────────────────────────────────
      gsap.fromTo('.services-fade',
        { y: 30, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.7, stagger: 0.1, ease: 'power3.out',
          scrollTrigger: { trigger: '#services', start: 'top 80%' } }
      );

      (gsap.utils.toArray('.service-card') as Element[]).forEach((card, i) => {
        gsap.fromTo(card,
          { y: 40, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out', delay: i * 0.1,
            scrollTrigger: { trigger: card, start: 'top 88%' } }
        );
      });

      // ── About section ─────────────────────────────────────────
      gsap.fromTo('#about-header',
        { y: 30, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out',
          scrollTrigger: { trigger: '#about-header', start: 'top 85%' } }
      );

      gsap.fromTo('.about-para',
        { y: 20, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out', stagger: 0.15,
          scrollTrigger: { trigger: '.about-para', start: 'top 85%' } }
      );

      // ── FAQ fade ─────────────────────────────────────────────
      gsap.fromTo('.faq-fade',
        { y: 20, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.6, stagger: 0.08, ease: 'power3.out',
          scrollTrigger: { trigger: '#faq', start: 'top 80%' } }
      );
    };

    // ── FAQ accordion ─────────────────────────────────────────────
    const initFAQ = () => {
      const items = document.querySelectorAll('.faq-item');

      const openItem = (item: Element) => {
        const answer = item.querySelector('.faq-answer') as HTMLElement;
        const inner = answer.firstElementChild as HTMLElement;
        const btn = item.querySelector('.faq-trigger') as HTMLButtonElement;
        if (!answer || !inner) return;

        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        answer.style.height = inner.offsetHeight + 'px';
      };

      const closeItem = (item: Element) => {
        const answer = item.querySelector('.faq-answer') as HTMLElement;
        const btn = item.querySelector('.faq-trigger') as HTMLButtonElement;
        if (!answer) return;

        item.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        answer.style.height = '0';
      };

      items.forEach((item, i) => {
        const btn = item.querySelector('.faq-trigger') as HTMLButtonElement;
        if (!btn) return;

        // Open first by default
        if (i === 0) openItem(item);

        btn.addEventListener('click', () => {
          const isOpen = item.classList.contains('open');
          items.forEach(closeItem);
          if (!isOpen) openItem(item);
        });
      });
    };

    document.addEventListener('astro:page-load', () => {
      initAnimations();
      initFAQ();
    });
  </script>

  <style>
    /* Avatar must NOT mirror in RTL */
    [dir="rtl"] #hero-avatar {
      transform: none !important;
    }
    [dir="rtl"] #hero-avatar img {
      transform: none !important;
    }
  </style>
</BaseLayout>
